{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main + doc window capability: dialog + fs (read/write/watch anywhere) + store + shell-open. v4.8 多窗口：windows 覆盖 main 与 doc-*（不改则新窗口所有 invoke 失败）；增补 destroy（非最后一窗只能 destroy 自己）与 set-title（窗口标题同步）两项必需权限。PI2 打印改应用内 GDI 直打后不经 shell-open；openExternal 仅「用系统应用打开」/外链使用，其唯一值闸门是 tauri.conf.json plugins.shell.open 正则（plugin-shell 2.3.5 的 open 命令只校验该配置正则，本文件 url/path 条目为声明性 scope）；打印临时目录读写由 fs 侧 $APPDATA/** 覆盖。",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "store:default",

    "process:default",

    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    },

    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-unwatch",
    "fs:allow-watch",
    { "identifier": "fs:scope", "allow": [
      { "path": "$APPDATA/**" },
      { "path": "$DOCUMENT/**" }
    ] }
  ]
}
